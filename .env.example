# Shared by DevContainer, backend, and frontend.

# SQLAlchemy database URL for agent development. The stable local Compose
# stack overrides this internally with its PostgreSQL service URL.
DATABASE_URL=sqlite:///./family_kanban.db
# DATABASE_URL=postgresql+psycopg://family:family@localhost:5432/family_kanban

# Postgres compose service credentials (used when DATABASE_URL targets `db`).
POSTGRES_USER=family
POSTGRES_PASSWORD=family
POSTGRES_DB=family_kanban

# Frontend API base URL. Leave empty for same-origin /api (Vite proxies to
# http://localhost:8000 in dev). Set only if the API is on another origin.
VITE_API_BASE_URL=

# Stable local Compose host settings. Make derives COMPOSE_PROJECT_NAME from
# the current branch; override these values for manual docker compose commands
# or when running multiple local stacks at once.
COMPOSE_PROJECT_NAME=family-kanban-local
LOCAL_API_PORT=8000
LOCAL_FRONTEND_PORT=4173

# Resend — passwordless sign-in emails (default EMAIL_DELIVERY=resend).
# Step-by-step setup: _docs/resend-setup.md
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=Family Kanban <onboarding@resend.dev>
#
# Local without Resend: log codes to the backend terminal instead of emailing.
# EMAIL_DELIVERY=console
#
# Login code lifetime in minutes (default 5).
# LOGIN_CODE_TTL_MINUTES=5
